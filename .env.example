# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to client

# --- Resend (email) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL="Padel Club <bookings@yourclub.com>"

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_ADMIN_CHAT_ID=-100xxxxxxxxxx
CRON_SECRET=choose-a-long-random-string   # protects /api/cron/telegram-report

# --- Payments (sandbox-ready) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox                        # sandbox | live
BOG_MERCHANT_ID=
BOG_SECRET_KEY=
TBC_MERCHANT_ID=
TBC_SECRET_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLUB_NAME="Luki Padel"
NEXT_PUBLIC_CLUB_ADDRESS="12 Court Lane, Tbilisi"
